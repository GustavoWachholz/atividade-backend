# Pooler de sessão do Supabase (Project Settings > Database > Connection string > Session pooler).
# Se a senha tiver caracteres especiais ($, @, #), codifique-os (ex.: $ vira %24).
URL_DO_BANCO=postgresql+psycopg://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
CHAVE_DO_TOKEN=
CHAVE_DA_IA=
# Reserva da IA: o OpenRouter entra se todos os modelos do Gemini falharem (openrouter.ai/keys).
OPENROUTER_API_KEY=
# Cadastro de produtor: o código de ativação vai para EMAIL_DO_ADMIN pelo Resend (resend.com).
# CHAVE_DO_EMAIL é a chave da API do Resend. Sem as duas, o cadastro de produtor fica desligado.
EMAIL_DO_ADMIN=
CHAVE_DO_EMAIL=
ORIGEM_FRONTEND=http://localhost:5173
