# Pooler de sessão do Supabase (Project Settings > Database > Connection string > Session pooler).
# Se a senha tiver caracteres especiais ($, @, #), codifique-os (ex.: $ vira %24).
URL_DO_BANCO=postgresql+psycopg://postgres.SEU_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
CHAVE_DO_TOKEN=
ORIGEM_FRONTEND=http://localhost:5173
